# Copy to .env.local and fill in. Never commit .env.local.
# On Vercel, set these in Project Settings -> Environment Variables.

# --- Server only (Vercel functions + scripts). Never prefix with VITE_. ---

# Neon Postgres. Added automatically by the Vercel <-> Neon integration.
DATABASE_URL=

# Long random string used to sign session cookies (e.g. `openssl rand -hex 32`).
SESSION_SECRET=

# Shared family passcode entered on the login screen with an allowlisted email.
FAMILY_PASSCODE=

# Google Places API (New). Used by scripts/geocode.ts and /api/places-photo only.
GOOGLE_PLACES_API_KEY=

# --- Client (bundled into the app) ---

# Optional raster satellite layer, {z}/{x}/{y} template. Online only.
# Defaults to Esri World Imagery when empty.
VITE_SATELLITE_TILE_URL=

# true = run without the API: data from seed/ files, edits stay on this device.
# Handy for `npm run dev`. Never set this on the deployed site.
VITE_LOCAL_ONLY=

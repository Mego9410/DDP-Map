# Copy to .env.local and fill in. Never commit .env.local.

# Supabase (client-safe)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional raster satellite layer (online only)
VITE_SATELLITE_TILE_URL=

# Server-side only: used by scripts/ and the places-photo edge function.
# Never expose this to the client bundle.
GOOGLE_PLACES_API_KEY=
